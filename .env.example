# Upstream API origin. Use ONE provider per gateway instance.
# OpenAI: https://api.openai.com
# xAI/Grok API: https://api.x.ai
# Anthropic API: https://api.anthropic.com
TOKENSAVER_UPSTREAM_BASE_URL=https://api.openai.com

# Optional override. If set, this key is sent upstream and never logged.
# Keep real keys in your shell environment, not in a committed .env file.
# TOKENSAVER_UPSTREAM_API_KEY=

# Local-only by default.
TOKENSAVER_HOST=127.0.0.1
TOKENSAVER_PORT=8765

# Compaction controls.
TOKENSAVER_ENABLED=1
TOKENSAVER_KEEP_RECENT_MESSAGES=8
TOKENSAVER_SUMMARY_MAX_CHARS=3000
TOKENSAVER_MIN_OLD_CHARS=1200
TOKENSAVER_MAX_BODY_BYTES=10485760
TOKENSAVER_UPSTREAM_TIMEOUT=120

# Remote binding is blocked unless explicitly enabled. Do not expose directly.
# TOKENSAVER_ALLOW_REMOTE=1
# TOKENSAVER_ACCESS_LOG=1
