# Toknix upstream API origin. Use ONE provider per gateway instance.
# OpenAI: https://api.openai.com
# xAI/Grok API: https://api.x.ai
# Anthropic API: https://api.anthropic.com
TOKNIX_UPSTREAM_BASE_URL=https://api.openai.com

# Optional upstream credential override. Never commit a real key.
# TOKNIX_UPSTREAM_API_KEY=

# Local-only by default.
TOKNIX_HOST=127.0.0.1
TOKNIX_PORT=8765

# Compaction controls. Values are validated at startup.
TOKNIX_ENABLED=1
TOKNIX_KEEP_RECENT_MESSAGES=8
TOKNIX_SUMMARY_MAX_CHARS=3000
TOKNIX_MIN_OLD_CHARS=1200
TOKNIX_MIN_TOTAL_CHARS=5000
TOKNIX_CUT_STEP=4
TOKNIX_MAX_BODY_BYTES=10485760
TOKNIX_UPSTREAM_TIMEOUT=120
TOKNIX_TOOL_OUTPUT_MAX_CHARS=4000
TOKNIX_USAGE_TEE_MAX_BYTES=1000000

# Remote mode requires a long random token on every request, including /health and /stats.
# Never expose the gateway directly to the public internet; use authenticated TLS.
# TOKNIX_ALLOW_REMOTE=1
# TOKNIX_GATEWAY_TOKEN=replace-with-a-long-random-secret
# TOKNIX_ACCESS_LOG=1

# Backwards compatibility: TOKENSAVER_* variables are still accepted when the
# matching TOKNIX_* variable above is not set.
